<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Help Job - Sarkari & Private Jobs</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f4f4f4;
}

nav{
    background:#0d6efd;
    color:white;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 8%;
}

.logo{
    font-size:28px;
    font-weight:bold;
}

nav ul{
    list-style:none;
    display:flex;
}

nav ul li{
    margin-left:20px;
}

nav ul li a{
    text-decoration:none;
    color:white;
    font-weight:bold;
}

.hero{
    background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
    url('https://images.unsplash.com/photo-1521791136064-7986c2920216?w=1200');
    background-size:cover;
    background-position:center;
    height:80vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
    padding:20px;
}

.hero-content h1{
    font-size:50px;
    margin-bottom:15px;
}

.hero-content p{
    font-size:20px;
    margin-bottom:20px;
}

.btn{
    background:#ffc107;
    color:black;
    padding:12px 25px;
    text-decoration:none;
    border-radius:5px;
    font-weight:bold;
}

.section{
    padding:60px 8%;
}

.section h2{
    text-align:center;
    margin-bottom:30px;
    color:#333;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:white;
    padding:25px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,.1);
    text-align:center;
}

.card h3{
    margin-bottom:10px;
    color:#0d6efd;
}

.about{
    background:white;
}

.contact{
    background:#e9ecef;
}

form{
    max-width:600px;
    margin:auto;
}

input, textarea{
    width:100%;
    padding:12px;
    margin:10px 0;
    border:1px solid #ccc;
    border-radius:5px;
}

button{
    background:#0d6efd;
    color:white;
    border:none;
    padding:12px 25px;
    border-radius:5px;
    cursor:pointer;
}

footer{
    background:#212529;
    color:white;
    text-align:center;
    padding:20px;
}

@media(max-width:768px){

nav{
    flex-direction:column;
}

nav ul{
    margin-top:10px;
}

.hero-content h1{
    font-size:35px;
}

}
</style>
</head>

<body>

<nav>
    <div class="logo">Help Job</div>

    <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#">Sarkari Jobs</a></li>
        <li><a href="#">Private Jobs</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
    </ul>
</nav>

<section class="hero">
    <div class="hero-content">
        <h1>Find Your Dream Job</h1>
        <p>Latest Sarkari & Private Job Updates in One Place</p>
        <a href="#" class="btn">Explore Jobs</a>
    </div>
</section>

<section class="section">
    <h2>Job Categories</h2>

    <div class="cards">

        <div class="card">
            <h3>Sarkari Jobs</h3>
            <p>Railway, SSC, UPSC, Police, Bank and more.</p>
        </div>

        <div class="card">
            <h3>Private Jobs</h3>
            <p>IT, BPO, Manufacturing, Sales and more.</p>
        </div>

        <div class="card">
            <h3>Internships</h3>
            <p>Internship opportunities for students.</p>
        </div>

        <div class="card">
            <h3>Work From Home</h3>
            <p>Remote jobs and freelancing opportunities.</p>
        </div>

    </div>
</section>

<section class="section about">
    <h2>About Help Job</h2>

    <p style="text-align:center; max-width:800px; margin:auto;">
        Help Job is a platform where users can find the latest
        Sarkari and Private job opportunities. Our goal is to help
        job seekers stay updated with career opportunities.
    </p>
</section>

<section class="section contact">
    <h2>Contact Us</h2>

    <form>
        <input type="text" placeholder="Your Name">
        <input type="email" placeholder="Your Email">
        <textarea rows="5" placeholder="Your Message"></textarea>

        <button type="submit">Send Message</button>
    </form>
</section>

<footer>
    <p>© 2026 Help Job | All Rights Reserved</p>
</footer>

</body>
</html>
